{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/creative/ads/[adId]",
      "regex": "^/creative/ads/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPadId": "nxtPadId"
      },
      "namedRegex": "^/creative/ads/(?<nxtPadId>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/creative/ads/[adId].segments/!KGFwcCk/creative/ads/$d$adId$segment",
          "source": "^/creative/ads/(?<nxtPadId>[^/]+?)\\.segments/!KGFwcCk/creative/ads/\\$d\\$adId(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPadId": "nxtPadId"
          }
        }
      ]
    },
    {
      "page": "/events/[eventId]",
      "regex": "^/events/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPeventId": "nxtPeventId"
      },
      "namedRegex": "^/events/(?<nxtPeventId>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/events/[eventId].segments/!KGFwcCk/events/$d$eventId$segment",
          "source": "^/events/(?<nxtPeventId>[^/]+?)\\.segments/!KGFwcCk/events/\\$d\\$eventId(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPeventId": "nxtPeventId"
          }
        }
      ]
    },
    {
      "page": "/imports/[batchId]",
      "regex": "^/imports/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbatchId": "nxtPbatchId"
      },
      "namedRegex": "^/imports/(?<nxtPbatchId>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/imports/[batchId].segments/!KGFwcCk/imports/$d$batchId$segment",
          "source": "^/imports/(?<nxtPbatchId>[^/]+?)\\.segments/!KGFwcCk/imports/\\$d\\$batchId(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPbatchId": "nxtPbatchId"
          }
        }
      ]
    },
    {
      "page": "/portfolio/[sku]",
      "regex": "^/portfolio/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsku": "nxtPsku"
      },
      "namedRegex": "^/portfolio/(?<nxtPsku>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/portfolio/[sku].segments/!KGFwcCk/portfolio/$d$sku$segment",
          "source": "^/portfolio/(?<nxtPsku>[^/]+?)\\.segments/!KGFwcCk/portfolio/\\$d\\$sku(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPsku": "nxtPsku"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
