# =============================================================================
# Uray Commerce Intelligence — environment variables (ALL server-side)
# Local: copy to .env.local.  cPanel: set in "Setup Node.js App" → Environment
# variables, or create .env next to server.js (outside public_html).
# NEVER commit real values. See docs/environment.md.
# =============================================================================

# --- Database (cPanel → MySQL® Databases) ------------------------------------
# On cPanel the app and database run on the same server: DB_HOST=localhost.
# cPanel prefixes names with your account, e.g. maduuray_uci / maduuray_app.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Pool size per app process. Keep small on shared hosting (default 5).
DB_CONNECTION_LIMIT=5
# Alternative to the DB_* variables (URL-encode special characters):
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# --- Application ---------------------------------------------------------------
# Public origin. https:// enables Secure, __Host- prefixed session cookies.
APP_URL=http://localhost:3000

# --- AI insights (Groq) ---------------------------------------------------------
# Groq API key (console.groq.com → API Keys). Server-side only; empty = AI off.
GROQ_API_KEY=
# Optional. Must support structured outputs (json_schema). Default: openai/gpt-oss-120b
GROQ_MODEL=
# Optional OpenAI-compatible base URL (default https://api.groq.com/openai/v1).
# GROQ_BASE_URL=

# --- Operations ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
